---
import Layout from "../layouts/Layout.astro";
import { Github, Linkedin, Mail, BookOpen, MessageSquare } from "lucide-astro";
import { contact } from "../data/contact";

const links = [
  {
    label: "Email",
    href: contact.emailHref,
    hint: "Best for longer messages and collaboration.",
    Icon: Mail,
    primary: true,
  },
  {
    label: "LinkedIn",
    href: contact.linkedin,
    hint: "Best for job opportunities and professional networking.",
    Icon: Linkedin,
    primary: true,
  },
  {
    label: "GitHub",
    href: contact.github,
    hint: "Projects, code, and open-source work.",
    Icon: Github,
  },
  {
    label: "Medium",
    href: contact.medium,
    hint: "Articles and write-ups.",
    Icon: BookOpen,
  },
];

const topics = [
  "Unreal Engine C++ roles (systems/tools/online foundations)",
  ".NET backend & AppSec collaboration (ByteGuard and related)",
  "Open-source collaboration, code reviews, and architecture discussions",
  "Speaking/writing opportunities",
];
---

<Layout title="Contact">
  <section class="mx-auto max-w-5xl px-4 py-10 md:py-14">
    <div class="space-y-3">
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Contact</h1>
      <p class="text-base-content/80 text-lg max-w-3xl">
        Want to reach me, collaborate, or talk about a role? These are the best
        places to find me.
      </p>
    </div>

    <!-- Primary actions -->
    <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        links
          .filter((l) => l.primary)
          .map((l) => (
            <a
              class="card border border-base-300 bg-base-100 shadow-sm hover:shadow-md transition-shadow"
              href={l.href}
              target={l.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={l.href.startsWith("mailto:") ? undefined : "noreferrer"}
            >
              <div class="card-body">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex items-start gap-3">
                    <div class="rounded-box bg-primary/10 p-3 text-primary">
                      <l.Icon class="h-5 w-5" />
                    </div>
                    <div>
                      <h2 class="card-title text-lg">{l.label}</h2>
                      <p class="text-base-content/70">{l.hint}</p>
                    </div>
                  </div>

                  <span class="btn btn-primary btn-sm">Open</span>
                </div>
              </div>
            </a>
          ))
      }
    </div>

    <!-- Other links -->
    <div class="mt-10">
      <h2 class="text-2xl font-bold tracking-tight">Elsewhere</h2>
      <p class="mt-1 text-base-content/70">More places you can find my work.</p>

      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          links
            .filter((l) => !l.primary)
            .map((l) => (
              <a
                class="card border border-base-300 bg-base-100 shadow-sm hover:shadow-md transition-shadow"
                href={l.href}
                target="_blank"
                rel="noreferrer"
              >
                <div class="card-body">
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex items-start gap-3">
                      <div class="rounded-box bg-base-200 p-3">
                        <l.Icon class="h-5 w-5" />
                      </div>
                      <div>
                        <h3 class="font-semibold">{l.label}</h3>
                        <p class="text-sm text-base-content/70">{l.hint}</p>
                      </div>
                    </div>
                    <span class="btn btn-neutral btn-sm">Open</span>
                  </div>
                </div>
              </a>
            ))
        }
      </div>
    </div>

    <!-- What to contact me about -->
    <div class="mt-10 md:mt-12">
      <div class="card border border-base-300 bg-base-200/40">
        <div class="card-body">
          <h2 class="card-title text-xl">What to contact me about</h2>
          <p class="text-base-content/80">
            I’m always up for a chat if it’s in one of these areas:
          </p>

          <ul class="mt-3 space-y-2">
            {
              topics.map((t) => (
                <li class="flex gap-2">
                  <span class="mt-[2px] inline-flex h-5 w-5 items-center justify-center rounded-full bg-primary/15 text-primary">
                    ✓
                  </span>
                  <span class="text-base-content/80">{t}</span>
                </li>
              ))
            }
          </ul>

          <div class="alert alert-info mt-5">
            <span>
              Tip: Email is best for longer messages; LinkedIn is best for roles
              and professional outreach.
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
