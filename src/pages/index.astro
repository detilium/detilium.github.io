---
import Layout from "../layouts/Layout.astro";
import { Github, Linkedin, Mail, ArrowRight } from "lucide-astro";
import { getCollection } from "astro:content";
import { contact } from "../data/contact";

const FEATURED = ["solitaire", "todoloo"];

const allProjects = await getCollection("projects");
const featuredProjects = FEATURED.map((slug) =>
  allProjects.find((p) => p.slug === slug),
).filter(Boolean);
---

<Layout title="Christian Haase">
  <section class="py-16 sm:py-24">
    <div class="text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight">
        Hi, I'm {contact.name} 👋
      </h1>
      <p class="mt-4 text-lg text-gray-400">
        Systems-focused game programmer building modular gameplay systems and
        robust foundations in Unreal Engine C++, backed by ~10 years of software
        engineering experience.
        <span class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
          <a class="btn btn-neutral" href="/projects">projects</a>
          <a class="btn btn-neutral" href="/about">about</a>
          <a class="btn btn-neutral" href="/contact">contact</a>
        </span>
      </p>
    </div>
  </section>

  <section class="py-10 sm:py-12">
    <div class="mx-auto max-w-5xl px-4">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:items-center">
        {/* Left: intro copy */}
        <div class="md:col-span-8">
          <h2 class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight">
            I build gameplay systems in Unreal Engine C++—modular architecture,
            solid foundations, and tools that keep iteration fast.
          </h2>

          <p
            class="mt-3 text-base sm:text-lg text-base-content/75 leading-relaxed max-w-2xl"
          >
            My work focuses on gameplay architecture, modular features, reusable
            systems, developer tooling, and performance-minded C++. I enjoy
            taking ideas from early prototypes to polished implementations, with
            code that remains understandable as a game grows.
          </p>

          <div class="mt-4 flex flex-wrap gap-2">
            <span class="badge badge-ghost">Unreal Engine</span>
            <span class="badge badge-ghost">C++</span>
            <span class="badge badge-ghost">Gameplay Systems</span>
            <span class="badge badge-ghost">Gameplay Architecture</span>
            <span class="badge badge-ghost">Modular Features</span>
            <span class="badge badge-ghost">Developer Tooling</span>
            <span class="badge badge-ghost">Performance</span>
            <span class="badge badge-ghost">Prototyping</span>
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-3">
            <a class="btn btn-neutral btn-sm" href="/about">
              Read more <ArrowRight class="h-4 w-4" />
            </a>

            <div class="flex items-center gap-2">
              <a
                class="btn btn-ghost btn-sm"
                href={contact.linkedin}
                target="_blank"
                rel="noreferrer"
                aria-label="LinkedIn"
                title="LinkedIn"
              >
                <Linkedin class="h-4 w-4" />
              </a>
              <a
                class="btn btn-ghost btn-sm"
                href={contact.emailHref}
                aria-label="Email"
                title="Email"
              >
                <Mail class="h-4 w-4" />
              </a>
              <a
                class="btn btn-ghost btn-sm"
                href={contact.github}
                target="_blank"
                rel="noreferrer"
                aria-label="GitHub"
                title="GitHub"
              >
                <Github class="h-4 w-4" />
              </a>
            </div>
          </div>
        </div>

        <div class="md:col-span-4">
          <div class="card border border-base-300 bg-base-100 shadow-sm">
            <div class="card-body">
              <div class="text-sm text-base-content/60">Focus</div>
              <div class="text-lg font-semibold">Gameplay foundations</div>
              <p class="mt-2 text-sm text-base-content/70">
                I enjoy turning game ideas into reusable, data-driven
                systems—building the engine-side code, debugging tools, and
                workflows that make iteration faster and features easier to
                evolve.
              </p>

              <div class="mt-3 flex flex-wrap gap-2">
                <span class="badge badge-outline badge-sm"
                  >Gameplay Systems</span
                >
                <span class="badge badge-outline badge-sm"
                  >Developer Tooling</span
                >
                <span class="badge badge-outline badge-sm"
                  >Data-Driven Design</span
                >
              </div>

              <div class="mt-4">
                <a class="btn btn-outline btn-sm w-full" href="/projects">
                  Explore projects <ArrowRight class="h-4 w-4" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-5xl px-4">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">
            Featured projects
          </h2>
          <p class="mt-2 text-base-content/70">
            A curated selection of projects I’m actively proud to showcase.
          </p>
        </div>
        <a class="link link-hover hidden sm:inline" href="/projects"
          >View all →</a
        >
      </div>

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          featuredProjects.map((p) => (
            <a
              class="card card-border bg-base-100 shadow-sm hover:shadow-md transition-shadow cursor-pointer"
              href={`/projects/${p.slug}`}
              aria-label={`Open project: ${p.data.title}`}
            >
              {p.data.thumbnail ? (
                <figure>
                  <img
                    src={p.data.thumbnail}
                    alt={p.data.title}
                    class="h-44 w-full object-cover"
                    loading="lazy"
                  />
                </figure>
              ) : null}

              <div class="card-body">
                <h3 class="card-title text-lg">{p.data.title}</h3>
                <p class="text-base-content/75">{p.data.summary}</p>

                {p.data.tags?.length ? (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {p.data.tags.slice(0, 6).map((t) => (
                      <span class="badge badge-ghost">{t}</span>
                    ))}
                  </div>
                ) : null}

                <div class="card-actions mt-4 justify-end">
                  <span class="text-sm text-base-content/60">
                    View project →
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>

      <div class="mt-6 sm:hidden">
        <a class="link link-hover" href="/projects">View all →</a>
      </div>
    </div>
  </section>
</Layout>
